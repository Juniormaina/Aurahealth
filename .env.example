# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase (server). Web API key is public; used only to look up ID tokens.
# Override if you point the app at a different Firebase project.
# FIREBASE_WEB_API_KEY=
# FIREBASE_PROJECT_ID=aura-health-f478f

# Admin console. Server-only allowlist of verified emails that may call
# GET /api/admin/session, /api/corporate/leads, and /api/funnel/summary.
# Do not prefix this with VITE_ — it must not ship in the client bundle.
ADMIN_EMAILS=""

# Firebase Admin (server). Required to persist Cowries, XP, and streaks.
# Client writes of those fields are rejected by Firestore rules.
# Use a service-account JSON string, or client email + private key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
