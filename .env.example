# GEMINI_API_KEY: Required for Gemini AI API calls (server-only).
# Never prefix with VITE_ — secrets must not ship in the client bundle.
GEMINI_API_KEY=

# Optional Tavily key for grounding Astra factual answers (server-only).
# TAVILY_API_KEY=

# PORT: Listen port. Cloud Run and most hosts inject this; defaults to 3000.
# PORT=3000

# APP_URL: Canonical public origin (OAuth callbacks, CORS allowlist).
# Example: https://www.aurahealth.co.ke
APP_URL=

# Extra browser origins allowed for CORS (comma-separated), beyond APP_URL
# and the built-in Aura Health domains / localhost.
# CORS_ORIGINS=https://staging.example.com

# Firebase (server). Web API key is public but restrict it by HTTP referrer
# in Google Cloud. Used for ID token lookup when Admin SDK is unavailable.
# FIREBASE_WEB_API_KEY=
# FIREBASE_PROJECT_ID=aura-health-f478f

# Admin console. Server-only allowlist of verified emails that may call
# GET /api/admin/session, /api/corporate/leads, and /api/funnel/summary.
# Do not prefix this with VITE_ — it must not ship in the client bundle.
ADMIN_EMAILS=

# Firebase Admin (server). Required to persist Cowries, XP, and streaks,
# and preferred for ID token verification with revocation checks.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Demo / local only: allow POST /api/subscriptions/checkout to grant Premium
# without a payment provider. Defaults to on outside production.
# In production, leave unset (checkout returns 402) until Stripe (or similar)
# is wired — or set to 1 only for staged demos.
# ALLOW_UNPAID_CHECKOUT=1

# Security flags
# NODE_ENV=production
