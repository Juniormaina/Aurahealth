# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase (server). Web API key is public; used only to look up ID tokens.
# Override if you point the app at a different Firebase project.
# FIREBASE_WEB_API_KEY=
# FIREBASE_PROJECT_ID=aura-health-f478f

# Admin console (sponsor pools / contracts). Leave unset to keep /admin locked.
# Comma-separated emails that may enter after signing in, and/or a staff access code.
# ADMIN_EMAILS is the server allowlist for GET /api/corporate/leads and /api/funnel/summary.
# VITE_ADMIN_EMAILS is also read by the server if ADMIN_EMAILS is unset (local convenience).
VITE_ADMIN_EMAILS=""
VITE_ADMIN_ACCESS_CODE=""
ADMIN_EMAILS=""
